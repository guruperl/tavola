#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
args=()
dry_run=0

while (($#)); do
  case "$1" in
    --config)
      shift
      [[ $# -gt 0 ]] || { printf 'Missing value for --config\n' >&2; exit 2; }
      shift
      ;;
    --config=*)
      shift
      ;;
    --web-ui|--no-web-ui)
      shift
      ;;
    --dry-run)
      dry_run=1
      shift
      ;;
    *)
      args+=("$1")
      shift
      ;;
  esac
done

if ((dry_run)); then
  args+=("--dry-run")
fi

cd "$ROOT"
GOWORK=off go run ./cmd/tavola-generate "${args[@]}"
