#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
WORKSPACE="$(cd "$ROOT/.." && pwd)"
MODE="all"

usage() {
  cat <<'USAGE'
Usage: script/verify-sqlmeta-workflow [--fast|--integration|--all]

Modes:
  --fast         Refresh/check contract drift, run sqlmeta tests, and run Tavola
                 consumer/source-of-truth/generated-app smoke checks.
  --integration  Run Docker-backed molecule/golet harnesses and golet vet.
  --all          Run fast and integration checks. Default.
USAGE
}

while (($#)); do
  case "$1" in
    --fast)
      MODE="fast"
      ;;
    --integration)
      MODE="integration"
      ;;
    --all)
      MODE="all"
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      usage >&2
      exit 2
      ;;
  esac
  shift
done

go_env=(
  GIT_CONFIG_COUNT=1
  GIT_CONFIG_KEY_0=url.git@github.com:.insteadOf
  GIT_CONFIG_VALUE_0=https://github.com/
  GOWORK=off
  GOPRIVATE=github.com/genelet/*
  GONOSUMDB=github.com/genelet/*
  GOPROXY=direct
)

run_go() {
  local dir="$1"
  shift
  (
    cd "$dir"
    env "${go_env[@]}" "$@"
  )
}

check_contract_drift() {
  local stale=()
  local paths=(
    "$WORKSPACE/sqlmeta/xmeta/testdata/contracts/manual_pk_fk.expanded_app_spec.json"
    "$WORKSPACE/sqlmeta/tavola/testdata/contracts/manual_pk_fk.project.json"
    "$WORKSPACE/sqlmeta/tavola/testdata/contracts/manual_pk_fk.warnings.txt"
    "$WORKSPACE/sqlmeta/xmeta/testdata/contracts/invalid_overrides.expanded_app_spec.json"
    "$WORKSPACE/sqlmeta/tavola/testdata/contracts/invalid_overrides.project.json"
    "$WORKSPACE/sqlmeta/tavola/testdata/contracts/invalid_overrides.warnings.txt"
    "$WORKSPACE/sqlmeta/xmeta/testdata/contracts/missing_auth_table.expand_error.txt"
    "$WORKSPACE/sqlmeta/tavola/testdata/contracts/missing_auth_table.tavola_error.txt"
    "$ROOT/specs/sqlmeta.project.json"
  )

  for path in "${paths[@]}"; do
    local repo
    repo="$(git -C "$(dirname "$path")" rev-parse --show-toplevel)"
    local rel
    rel="$(git -C "$repo" ls-files --full-name "$path")"
    if [[ -z "$rel" ]]; then
      stale+=("$path")
      continue
    fi
    if ! git -C "$repo" diff --quiet -- "$rel"; then
      stale+=("$path")
    fi
  done

  if ((${#stale[@]} > 0)); then
    printf 'Contract fixtures are stale. Run `../sqlmeta/script/refresh-contract-fixtures` and commit the generated files.\n' >&2
    printf 'Stale generated files:\n' >&2
    printf '  %s\n' "${stale[@]}" >&2
    return 1
  fi
}

run_fast() {
  run_go "$WORKSPACE/sqlmeta" ./script/refresh-contract-fixtures
  check_contract_drift
  run_go "$WORKSPACE/sqlmeta" go test ./...

  (
    cd "$ROOT"
    prove -Ilib -I../perl t/sqlmeta-output.t t/source-truth-json.t
    script/smoke-generated-project --spec specs/supportdesk.project.json --lang all
    script/smoke-sqlite-init
  )
}

run_integration() {
  run_go "$WORKSPACE/molecule" env MOLECULE_MYSQL_PORT="${MOLECULE_MYSQL_PORT:-3330}" MOLECULE_POSTGRES_PORT="${MOLECULE_POSTGRES_PORT:-5456}" ./scripts/harness-test.sh ./...
  run_go "$WORKSPACE/golet" env GOLET_MYSQL_PORT="${GOLET_MYSQL_PORT:-3331}" GOLET_POSTGRES_PORT="${GOLET_POSTGRES_PORT:-5457}" ./scripts/harness-test.sh ./...
  run_go "$WORKSPACE/golet" go vet ./...
}

case "$MODE" in
  fast)
    run_fast
    ;;
  integration)
    run_integration
    ;;
  all)
    run_fast
    run_integration
    ;;
esac
