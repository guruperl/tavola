#!/usr/bin/perl

use strict;
use warnings;

use FindBin qw($Bin);
use lib "$Bin/../lib", "$Bin/../../perl";

use Getopt::Long qw(GetOptions);
use Tavola::Project::Spec;

my $config = "$Bin/../conf/config.json";
my $spec;
my $replace = 0;
my $dry_run = 0;
my $help = 0;

GetOptions(
	'config=s' => \$config,
	'spec=s'   => \$spec,
	'replace'  => \$replace,
	'dry-run'  => \$dry_run,
	'help'     => \$help,
) or usage(2);

usage(0) if $help;
usage(2) unless $spec;

Tavola::Project::Spec->new(
	config_path => $config,
	spec_path   => $spec,
	replace     => $replace,
	dry_run     => $dry_run,
)->run();

exit 0;

sub usage {
	my $exit = shift;
	print <<"USAGE";
Usage: script/import-project-spec --spec specs/jenny.project.json [options]

Options:
  --config PATH  Tavola metadata DB config. Defaults to conf/config.json.
  --replace      Delete the owner's existing project before importing.
  --dry-run      Validate and print the planned inserts without DB writes.
  --help         Show this help.
USAGE
	exit $exit;
}
