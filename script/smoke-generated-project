#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SPEC=""
LANG="all"
WEB_UI=0

usage() {
  cat <<'USAGE'
Usage: script/smoke-generated-project --spec PATH [options]

Options:
  --lang php|perl|go|all  Language to generate. Default: all.
  --web-ui                Accepted for compatibility; Go generator currently emits backend/API files.
  --no-web-ui             Accepted for compatibility.
  --help                  Show this help.
USAGE
}

while (($#)); do
  case "$1" in
    --spec)
      shift
      SPEC="${1:-}"
      shift
      ;;
    --spec=*)
      SPEC="${1#*=}"
      shift
      ;;
    --lang)
      shift
      LANG="${1:-}"
      shift
      ;;
    --lang=*)
      LANG="${1#*=}"
      shift
      ;;
    --web-ui)
      WEB_UI=1
      shift
      ;;
    --no-web-ui)
      WEB_UI=0
      shift
      ;;
    --config)
      shift 2
      ;;
    --config=*)
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      usage >&2
      exit 2
      ;;
  esac
done

[[ -n "$SPEC" ]] || { usage >&2; exit 2; }
case "$LANG" in
  php|perl|go) langs=("$LANG") ;;
  all) langs=(php perl go) ;;
  *) printf "Unsupported --lang '%s'. Use php, perl, go, or all.\n" "$LANG" >&2; exit 2 ;;
esac

TMP="$(mktemp -d "${TMPDIR:-/tmp}/tavola-smoke-XXXXXX")"
trap 'rm -rf "$TMP"' EXIT

for target in "${langs[@]}"; do
  out="$TMP/$target"
  "$ROOT/script/generate-project" --spec "$SPEC" --lang "$target" --out "$out" --replace --deterministic
  python3 - "$out" "$target" "$ROOT/docs/api.schema.json" <<'PY'
import json
import pathlib
import sys

root = pathlib.Path(sys.argv[1])
target = sys.argv[2]
schema = json.loads(pathlib.Path(sys.argv[3]).read_text())
for rel in ["api.json", "openapi.json", "docs/api.md", "docs/api.schema.json", "conf/config.json", "conf/init.sql", "logs/debug.log"]:
    if not (root / rel).exists():
        raise SystemExit(f"missing {rel}")
api = json.loads((root / "api.json").read_text())
openapi = json.loads((root / "openapi.json").read_text())
if api.get("format") != "tavola-api-manifest":
    raise SystemExit("api.json has unexpected format")
if not api.get("components"):
    raise SystemExit("api.json has no components")
for key in schema.get("required", []):
    if key not in api:
        raise SystemExit(f"api.json missing required key {key}")
if not openapi.get("openapi") or not openapi.get("paths"):
    raise SystemExit("openapi.json is incomplete")
if target == "php":
    required = ["composer.json", "www/app.php", "src/Application.php"]
    if "Controller(" not in (root / "src/Application.php").read_text():
        raise SystemExit("PHP Application does not construct Genelet Controller")
elif target == "perl":
    required = ["script/app"]
    if "Genelet::Dispatch::run" not in (root / "script/app").read_text():
        raise SystemExit("Perl app does not dispatch through Genelet")
else:
    required = ["go.mod", "README.md", "internal/app/app.go"]
for rel in required:
    if not (root / rel).exists():
        raise SystemExit(f"missing {rel}")
PY
  if [[ "$target" == "php" ]]; then
    if command -v php >/dev/null 2>&1; then
      find "$out" -name '*.php' -print0 | xargs -0 -n1 php -l >/dev/null
    fi
  elif [[ "$target" == "go" ]]; then
    (
      cd "$out"
      GOWORK=off go mod tidy
      GOWORK=off go test ./...
    )
  fi
  printf 'smoke %s ok: %s\n' "$target" "$out"
done

printf 'smoke complete: %s\n' "${langs[*]}"
