[% INCLUDE start.en %]
[% SET item=edit.0 %]

   <section class="doc-section">
<h2>Profile Management</h2>
        <div class="section-block">


<ul class="nav nav-tabs" id="myTab" role="tablist">
  <li class="nav-item">
    <a class="nav-link active" id="memInfo-tab" data-toggle="tab" href="#memInfo" role="tab" aria-controls="memInfo" aria-selected="true">Profile</a>
  </li>
  <li class="nav-item">
    <a class="nav-link" id="changePass-tab" data-toggle="tab" href="#changePass" role="tab" aria-controls="changePass" aria-selected="false">Password</a>
  </li>
  <li class="nav-item">
    <a class="nav-link" id="changeEmail-tab" data-toggle="tab" href="#changeEmail" role="tab" aria-controls="changeEmail" aria-selected="false">Email</a>
  </li>
</ul>

<p> </p>

<div class="tab-content" id="myTabContent">

  <div class="tab-pane fade show active" id="memInfo" role="tabpanel" aria-labelledby="memInfo-tab">
<form class="form" name=updateform action=member method=post>
<input type=hidden name="action" value="update" />

<div class="jumbotron text-left">

<div class="form-group row">
    <label for="firstName" class="col-sm-2 px-1 col-form-label text-right">Firstname</label>
    <div class="col-sm-2 px-1">
        <input type="text" class="form-control input-sm" name=firstname id="firstName" value="[% item.firstname %]">
    </div>
    <label for="lastName" class="col-sm-2 px-1 col-form-label text-right">Lastname</label>
    <div class="col-sm-2 px-1">
        <input type="text" class="form-control input-sm" name=lastname id="lastName" value="[% item.lastname %]">
    </div>
    <label for="phone" class="col-sm-2 px-1 col-form-label text-right">Phone</label>
    <div class="col-sm-2 px-1">
        <input type="text" class="form-control input-sm" name=phone id="phone" value="[% item.phone %]">
    </div>
</div>

<div class="form-group row">
    <label for="street" class="col-sm-2 px-1 col-form-label text-right">Address</label>
    <div class="col-sm-4 px-1">
        <input type="text" class="form-control input-sm" name=street id="street" value="[% item.street %]">
    </div>
    <label for="city" class="col-sm-2 px-1 col-form-label text-right">City</label>
    <div class="col-sm-4 px-1">
        <input type="text" class="form-control input-sm" name=city id="city" value="[% item.city %]">
    </div>
</div>

<div class="form-group row">
    <label for="country" class="col-sm-2 px-1 col-form-label text-right">Country</label>
    <div class="col-sm-2 px-1">
                <select class="custom-select d-block w-100" name="country" id="country" required>[% FOREACH c IN member_countries %]
				  <option [% IF item.country==c %]selected[% END %] value="[% c %]">[% c %]</option>
                [% END %]</select>
    </div>
    <label for="state" class="col-sm-2 px-1 col-form-label text-right">Province/State</label>
    <div class="col-sm-2 px-1">
        <input type="text" class="form-control input-sm" name=state id="state" value="[% item.state %]">
    </div>
    <label for="zip" class="col-sm-2 px-1 col-form-label text-right">Zip</label>
    <div class="col-sm-2 px-1">
        <input type="text" class="form-control input-sm" name=zip id="zip" value="[% item.zip %]">
    </div>
</div>

<div class="form-group row">
              <div class="col-md-4 mb-3"> </div>
              <div class="col-md-4 mb-3">
                <button class="btn btn-primary" type="submit"> Update Profile </button>
			  </div>
</div>

	 </div>
     </form>
  </div>

  <div class="tab-pane fade" id="changePass" role="tabpanel" aria-labelledby="changePass-tab">
<form class="form" name=f2 action=member method=post>
<input type=hidden name=action value=changepass>
<div class="jumbotron text-left">


	<div class="form-group row">
                <label for="passwd" class="col-md-3 mb-3 text-right">Current Password</label>
              <div class="col-md-3 mb-3">
				<input type="password" class="form-control" name="oldpasswd" id="passwd" value="">
              </div>
              <div class="col-md-6 mb-3">
              </div>
    </div>
    <div class="form-group row">
                <label for="passwd" class="col-md-3 mb-3 text-right">New Password</label>
              <div class="col-md-3 mb-3">
				<input type="password" class="form-control" name="passwd" id="passwd" value="">
              </div>
                <label for="confirmpass" class="col-md-2 mb-3 text-right">Confirm</label>
              <div class="col-md-3 mb-3">
				<input type="password" class="form-control" name="confirmpass" id="confirmpass" value="">
              </div>
            </div>

            <div class="form-group row">
              <div class="col-md-3 mb-3"> </div>
              <div class="col-md-3 mb-3">
                <button class="btn btn-primary" type="submit">Change Password</button>
			  </div>
            </div>

   </div>
</form>
</div>

<div class="tab-pane fade" id="changeEmail" role="tabpanel" aria-labelledby="changeEmail-tab">
<form class="form" name=f3 action=member method=post>
<input type=hidden name=action value=changeemail>
<p>
<h5>Your current email address: [% item.email %]</h5>
</p>
<div class="jumbotron text-left">
            <div class="form-group row">
                <label for="passwd2" class="col-md-3 mb-3 text-right">Current Password</label>
              <div class="col-md-3 mb-3">
				<input type="password" class="form-control" name="passwd" id="passwd2" value="">
              </div>
              <div class="col-md-6 mb-3">
              </div>
            </div>
            <div class="form-group row">
                <label for="newemail" class="col-md-3 mb-3 text-right">New Email</label>
              <div class="col-md-3 mb-3">
				<input type="text" class="form-control" name="newemail" id="newemail" value="">
              </div>
                <label for="confirm2" class="col-md-2 mb-3 text-right">Confirm</label>
              <div class="col-md-3 mb-3">
				<input type="text" class="form-control" name="confirmemail" id="confirm2" value="">
              </div>
            </div>

            <div class="form-group row">
              <div class="col-md-3 mb-3"> </div>
              <div class="col-md-3 mb-3">
                <button class="btn btn-primary" type="submit">Change Email</button>
			  </div>
            </div>

          </div>
</form>
  </div>

</div>


		</div>
	</section>
[% INCLUDE end.en %]
