[% INCLUDE start.en %]


[% IF (m_groupid==memberid) %]
	<section class="doc-section">
		<h2>Team Management</h2>
		<div class="section-block">
	[% IF topics %]
			[% INCLUDE topics_team.en %]
	[% ELSE %]
        <p>You currently have no team account.</p>
	[% END %]
	[% IF (total_existing < total_account) %]
			[% INCLUDE topics_team_add.en %]
	[% END %]
		</div>
	</section>
[% ELSE %]
	<section class="doc-section">
		<h2>Main Account</h2>
		<div class="section-block">
			<p>
				<a class="btn btn-primary" href="team?action=loginas&group_memberid=[% m_groupid %]">Back to Main Account</a>
			</p>
		</div>
	</section>
[% END %]


[% INCLUDE end.en %]
