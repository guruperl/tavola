<!-- Modal -->
[% SET single=item.ds_topics.0 %]

<div class="modal fade" id="dsModal" tabindex="-1" role="dialog" aria-labelledby="dsModalLabel" aria-hidden="true">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="dsModalLabel">[% single.nickname %]</h5>
        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <div class="modal-body">

[% IF item.ds == "online" %]
<div class="table-responsive">
<table class="table table-sm">
<thead>
<tr>
<th>Type</th>
<th>Host</th>
<th>Port</th>
<th>DB User</th>
<th>DB pass<th>
</tr>
</thead>
<tbody>
<tr>
<td>[% single.dbtype %]</td>
<td>[% single.host %]</td>
<td>[% single.port %]</td>
<td>[% single.dbuser %]</td>
<td>[% single.dbpass %]</td>
</tr>
</tbody>
</table>
</div>

[% ELSE %]

<form name=formmodal class="form" method="POST" action="ds">
<input type=hidden name="action" value="update">
<input type=hidden name="projectid" value="[% item.projectid %]">
<input type=hidden name="projectmd5" value="[% item.projectmd5 %]">
<input type=hidden name="dsid" value="[% single.dsid %]">
<input type=hidden name="csrf" value="[% item.csrf %]">

<div class="form-group row">
    <label class="col-4">Nickname:</label>
    <div class="col-8"><input class="form-control" type=text name='nickname' value="[% single.nickname %]"></div>
</div>
<div class="form-group row">
    <label class="col-4">Database Name:</label>
    <div class="col-8"><input class="form-control" type=text name='dbname' value="[% single.dbname %]"></div>
</div>
<div class="form-group row">
    <label class="col-4">Remote Host:</label>
    <div class="col-8"><input class="form-control" type=text name='host' value="[% single.host %]"></div>
</div>
<div class="form-group row">
    <label class="col-4">Port:</label>
    <div class="col-8"><input class="form-control" type=text name='port' value="[% single.port %]"></div>
</div>
<div class="form-group row">
    <label class="col-4">Access Username:</label>
    <div class="col-8"><input class="form-control" type=text name='dbuser' value="[% single.dbuser %]"></div>
</div>
<div class="form-group row">
    <label class="col-4">Access Password:</label>
    <div class="col-8"><input class="form-control" type=text name='dbpass' value="[% single.dbpass %]"></div>
</div>
<div class="form-group row">
    <div class="col-12"> &nbsp; </div>
    <div class="col-4"> </div>
    <div class="col-8">
<button class="btn btn-primary" type="submit">Update Data Source</button>
    </div>
</div>
</form>

[% END %]

      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
      </div>
    </div>
  </div>
</div>
