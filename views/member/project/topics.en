[% INCLUDE start.en %]
[% SET item=topics.0 %]

[% IF item %]
[% SET COMPS=item.component_topics %]

	<section class="doc-section">
		<h2>Project Summary</h2>
		<div class="section-block">
			[% INCLUDE topics_summary.en %]
		</div>

[% IF COMPS %]
		<p> &nbsp; </p>
		<h2>REST API Access</h2>
		<div class="section-block">
The specifications are defined in &nbsp <button class="btn btn-info py-0" style="font-size: 1.0em;" data-toggle="modal" data-target="#requestModal">Requests</button> and <button class="btn btn-info py-0" style="font-size: 1.0em;" data-toggle="modal" data-target="#responseModal">Responses</button>, respectively.
[% INCLUDE modal_request.en %]
[% INCLUDE modal_response.en %]
[% INCLUDE topics_api_public.en %]
[% INCLUDE topics_api_role.en %]
[% INCLUDE topics_api_admin.en %]
		</div>
[% END %]
	</section>

[% ELSE %]

	<section class="doc-section">
		<h2>Project Initialization</h2>
		<div class="section-block">
			[% INCLUDE topics_createdb.en %]
		</div>
	</section>

[% END %]



[% INCLUDE end.en %]
