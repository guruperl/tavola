		<form name="form_add_group" class="form" method=post action="team">
		<input type=hidden name="action" value="insert">
        <input type=hidden name="csrf" value="[% csrf %]">
			<div class="cards-wrapper row">
				<div class="col-md-12 col-12">

<div class="jumbotron text-left">
<h5>Add a team account:</h5>
<div class="form-group row">
    <label for="inputLogin" class="col-sm-2 px-1 col-form-label text-right">Login</label>
    <div class="col-sm-2 px-1">
        <input type="text" class="form-control input-sm" name=group_login id="inputLogin" placeholder="sandy">
    </div>
    <div class="col-sm-8 px-1">
        <em>a-z0-9 only, length 4-10, starting with letter!</em>
    </div>
</div>
<p>
<strong>All the following fields are optional.</strong>
</p>
<div class="form-group row">
    <label for="inputPassword3" class="col-sm-2 px-1 col-form-label text-right">Password</label>
    <div class="col-sm-2 px-1">
        <input type="password" class="form-control input-sm" name=passwd id="inputPassword3" placeholder="Password">
    </div>
    <label for="inputPassword4" class="col-sm-2 px-1 col-form-label text-right">Confirm</label>
    <div class="col-sm-2 px-1">
        <input type="password" class="form-control input-sm" name=confirm id="inputPassword4" placeholder="Password">
    </div>
    <label for="inputEmail3" class="col-sm-2 px-1 col-form-label text-right">Email</label>
    <div class="col-sm-2 px-1">
        <input type="email" class="form-control input-sm" name=email id="inputEmail3" placeholder="Email">
    </div>
</div>
<div class="form-group row">
    <label for="inputFirst" class="col-sm-2 px-1 col-form-label text-right">Firstname</label>
    <div class="col-sm-2 px-1">
        <input type="text" class="form-control input-sm" name=firstname id="inputFirst" placeholder="Firstname">
    </div>
    <label for="inputLast" class="col-sm-2 px-1 col-form-label text-right">Lastname</label>
    <div class="col-sm-2 px-1">
        <input type="text" class="form-control input-sm" name=lastname id="inputLast" placeholder="Lastname">
    </div>
    <label for="inputPhone" class="col-sm-2 px-1 col-form-label text-right">Phone</label>
    <div class="col-sm-2 px-1">
        <input type="text" class="form-control input-sm" name=phone id="inputPhone" placeholder="Phone number">
    </div>
</div>
<div class="form-group row">
    <div class="col-sm-1 px-1">
	</div>
    <div class="col-sm-11 px-1">
		<button class="btn btn-primary" type=submit> Add New </button>
	</div>
</div>
</div>

                </div>
            </div> 
		</form>
