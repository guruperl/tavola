<!-- Modal -->
<div class="modal fade" id="requestModal" tabindex="-1" role="dialog" aria-labelledby="requestModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="requestModalLabel">Tabilet API Requests</h5>
        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <div class="modal-body">

<div class="table-responsive">
<table class="table table-striped table-sm">
<thead class="thead-light">
<tr>
<th>HTTP<br>Method</th>
<th>URL Endpoint</th>
<th>Tabilet<br>Action</th>
<th>Options</th>
<th>Meaning</th>
</tr>
</thead>
<tbody>
<tr>
	<th><span class="badge badge-pill badge-info">GET</span></th>
	<td><samp>[% item.Server_url %][% item.Script %]/ROLE/json/COMPONENT</samp></td>
	<td><samp>topics</samp></td>
	<td><em>query</em></td>
	<td>LIST all</td>
</tr>
<tr>
	<th><span class="badge badge-pill badge-info">GET</span></th>
	<td><samp>[% item.Server_url %][% item.Script %]/ROLE/json/COMPONENT/ID</samp></td>
	<td><samp>edit</samp></td>
	<td><em>query</em></td>
	<td>READ one</td>
</div>
<tr>
	<th><span class="badge badge-pill badge-info">POST</span></th>
	<td><samp>[% item.Server_url %][% item.Script %]/ROLE/json/COMPONENT</samp></td>
	<td><samp>insert</samp></td>
	<td><em>body</em></td>
	<td>CREATE one</td>
</tr>
<tr>
	<th><span class="badge badge-pill badge-info">PUT</span></th>
	<td><samp>[% item.Server_url %][% item.Script %]/ROLE/json/COMPONENT</samp></td>
	<td><samp>update</samp></td>
	<td><em>body</em></td>
	<td>UPDATE one</td>
</tr>
<tr>
	<th><span class="badge badge-pill badge-info">PATCH</span></th>
	<td><samp>[% item.Server_url %][% item.Script %]/ROLE/json/COMPONENT</samp></td>
	<td><samp>insupd</samp></td>
	<td><em>body</em></td>
	<td>UPDATE or CREATE</td>
</tr>
<tr>
	<th><span class="badge badge-pill badge-info">DELETE</span></th>
	<td><samp>[% item.Server_url %][% item.Script %]/ROLE/json/COMPONENT</samp></td>
	<td><samp>delete</samp></td>
	<td><em>body</em></td>
	<td>DELETE one</td>
</tr>
</tbody>
</table>
</div>

<h5>Alternative and Recommended Way to Request API Data</h5>

<div class="table-responsive">
<table class="table table-striped table-sm">
<thead class="thead-light">
<tr>
<th>HTTP<br>Method</th>
<th>URL Endpoint</th>
<th>Options</th>
<th>Meaning</th>
</tr>
</thead>
<tbody>
<tr>
	<th><span class="badge badge-pill badge-info">GET</span></th>
	<td><samp>[% item.Server_url %][% item.Script %]/ROLE/json/COMPONENT</samp></td>
	<td><em>query</em></td>
	<td>LIST, READ or DELETE</td>
</tr>
<tr>
	<th><span class="badge badge-pill badge-info">POST</span></th>
	<td><samp>[% item.Server_url %][% item.Script %]/ROLE/json/COMPONENT</samp></td>
	<td><em>body</em></td>
	<td>CREATE, UPDATE or PATCH</td>
</tr>
</tbody>
</table>
</div>

<p>
	<em>action</em>=<em>insert|edit|topics|update|insupd|delete</em> MUST BE explicitely assigned in query or body. It will override the default Tabilet action inferred from the <strong>HTTP Request Method</strong>.
</p>
<p>
	Requests may have to send the RLS setting, i.e. foreign key and its signature, acquired from the previous response.
</p>
<p>
	The <strong>Content-Type</strong> of request body can either be <em>application/x-www-form-urlencoded</em> or <em>application/json</em>.
</p>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
      </div>
    </div>
  </div>
</div>

