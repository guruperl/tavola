  $('#componentid').on('change', function(e){
	if (this.value != "") {
    	$.ajax({
			url:"../json/component",
			tyep:'POST',
			data:{action:"edit", componentid:this.value, projectid:"[% projectid %]", projectmd5:"[% projectmd5 %]"},
		 	success:function(response) {
				pars = JSON.parse(response.data[0].table_edit[0].topics_pars);
				var h = "";
				pars.forEach(function(item, index) {
					h += "<option>"+item+"</option>";
				});
				$("#object_key").removeAttr('disabled').html(h);
			}
		});
	} else {
		$("#object_key").attr('disabled','disabled').html("<option value=''>-- Field --</option>");
	}
  });
