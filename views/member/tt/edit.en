[% INCLUDE start.en %]
[% SET item=edit.0 %]

   <section class="doc-section">
        <h2>Questions and Tickets</h2>
        <div class="section-block">

<h5>[% item.title %]</h5>

<p>
Category: <span class="badge badge-pill badge-info">[% item.category %]</span>
&nbsp; &nbsp;
Status: <span class="badge badge-pill [% IF item.status=="Close" %]badge-success[% ELSE %]badge-warning[% END %]">[% item.status %]</span>
</p>

    <div class="table-responsive">
        <table class="table table-striped">
            <thead class="thead-light">
<tbody>[% FOREACH atom=item.ttpost_topics %]
<tr>
<th>[% IF atom.party=='admin' %]Replied[% ELSE %]Asked[% END %]</th>
<td>[% atom.created %]</td>
</tr>
<tr><td colspan=2>[% atom.description %]</td></tr>
[% END %]</tbody>
</table>
	</div>

[% IF (item.status=='Open') %]
<div class="jumbotron text-left">

<form class="form" action=tt method=post>
<input type=hidden name=subjectid value='[% item.subjectid %]'>
<input type=hidden name=action value='reply'>
Follow up:
<p>
<textarea class="form-control col-8"rows=4 name=description></textarea>
</p>
<p>
Status: <input type=radio checked name=status value='Open'><span class="badge badge-pill badge-warning">Open</span> &nbsp; &nbsp;
<input type=radio name=status value='Close'><span class="badge badge-pill badge-success">Close</span>
</p>
<button class="btn btn-primary" type=submit> Add </button>
</form>

</div>
[% END %]

		</div>
	</section>

[% INCLUDE end.en %]
