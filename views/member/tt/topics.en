[% INCLUDE start.en %]

   <section class="doc-section">
        <h2>Questions and Tickets</h2>
        <div class="section-block">

<div class="table-responsive">
<table class="table table-striped">
	<thead class="thead-light">
<tr>
<th>Subject</th>
<th>Category</th>
<th>Status</th>
<th>When</th>
</tr>
</thead>
<tbody>[% FOREACH item=topics %]
<tr>
<td><a href="tt?action=edit&subjectid=[% item.subjectid %]">[% item.title %]</a></td>
<td><span class="badge badge-pill badge-info">[% item.category %]<span></td>
<td><span class="badge badge-pill [% IF item.status=="Close" %]badge-success[% ELSE %]badge-warning[% END %]">[% item.status %]</td>
<td>[% item.created %]</td>
</tr>
[% END %]</tbody>
</table>
</div>

		</div>

		<h2>Add New Ticket</h2>
		<div class="section-block">

<div class="jumbotron text-left">
<form class="form" action=tt method=post>
<input type=hidden name=action value='insert'>
<div class="form-group row">
	<label class="col-sm-3 col-form-label text-right px-1">Nickname:</label>
	<div class="col-sm-6 px-1"><input class="form-control" type=text name='name'></div>
</div>
<div class="form-group row">
	<label class="col-sm-3 col-form-label text-right px-1">How to Reach You:</label>
	<div class="col-sm-6 px-1"><input class="form-control" type=text name='comm' placeholder="email or phone #"></div>
</div>
<div class="form-group row">
	<label class="col-sm-3 col-form-label text-right px-1">Subject:</label>
	<div class="col-sm-6 px-1"><input type=text class="form-control" name=title></div>
</div>

<div class="form-group row">
	<label class="col-sm-3 col-form-label text-right px-1">Category:</label>
	<div class="col-sm-6 px-1"><select class="form-control" name=category>
<option value=''>- category -</option>
<option value='Development'>Software Development</option>
<option value='Deployment'>Package Deployment</option>
<option value='Account'>Account</option>
<option value='Other'>Other</option>
</select>
</div>
</div>

<div class="form-group row">
	<label class="col-sm-3 col-form-label text-right px-1">Description:</label>
	<div class="col-sm-6 px-1">
<textarea class="form-control" name=description rows=5></textarea>
</div>
</div>

<div class="form-group row">
	<label class="col-sm-3 col-form-label text-right px-1"></label>
	<div class="col-2"><button type=submit class="btn btn-primary">Submit</button>
	</div>
</div>

</form>
</div>

		</div>
	</section>
[% INCLUDE end.en %]
