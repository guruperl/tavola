<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="description" content="">
    <meta name="author" content="">

    <title>Tabilet 会员内网</title>

    <!-- Bootstrap core CSS -->
    <link href="https://getbootstrap.com/docs/4.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Custom styles for this template -->
    <link href="https://getbootstrap.com/docs/4.0/examples/dashboard/dashboard.css" rel="stylesheet">
  </head>

  <body>
    <nav class="navbar navbar-dark sticky-top bg-dark flex-md-nowrap p-0">
      <a class="navbar-brand col-sm-3 col-md-2 mr-0" target=_blank href="/">Tabilet: [% login %]</a>
      <input class="form-control form-control-dark w-100" type="text" placeholder="Search" aria-label="Search">
      <ul class="navbar-nav px-3">
        <li class="nav-item text-nowrap">
           <a class="nav-link" href="member?action=edit">[% m_name %] [% m_lastname %]</a>
        </li>  
      </ul>
      <ul class="navbar-nav px-3">
        <li class="nav-item text-nowrap">
           <a class="nav-link" href="logout">登出</a>
        </li>  
      </ul>
    </nav>

    <div class="container-fluid">
      <div class="row">
        <nav class="col-md-2 d-none d-md-block bg-light sidebar">
          <div class="sidebar-sticky">
            <h6 class="sidebar-heading d-flex justify-content-between align-items-center px-3 mt-4 mb-1 text-muted">
              <span>项目开发</span>
            </h6>
            <ul class="nav flex-column">
              <li class="nav-item">
                <a class="nav-link active" href="project?action=topics">
                  <span data-feather="home"></span>
                  项目 <span class="sr-only">(目前)</span>
                </a>
              </li>[% IF (projectid AND projectmd5) %]
              <li class="nav-item">
                <a class="nav-link" href="role?action=topics&projectid=[% projectid %]&projectmd5=[% projectmd5 %]">
                  <span data-feather="folder-plus"></span>
                  角色
                </a>
              </li>
              <li class="nav-item">
                <a class="nav-link" href="component?action=topics&projectid=[% projectid %]&projectmd5=[% projectmd5 %]">
                  <span data-feather="align-right"></span>
                  分量
                </a>
              </li>[% ELSIF (topics AND topics.0 AND topics.0.projectid AND topics.0.projectmd5) %]
              <li class="nav-item">
                <a class="nav-link" href="role?action=topics&projectid=[% topics.0.projectid %]&projectmd5=[% topics.0.projectmd5 %]">
                  <span data-feather="folder-plus"></span>
                  角色
                </a>
              </li>
              <li class="nav-item">
                <a class="nav-link" href="component?action=topics&projectid=[% topics.0.projectid %]&projectmd5=[% topics.0.projectmd5 %]">
                  <span data-feather="align-right"></span>
                  分量
                </a>
			  </li>
              <li class="nav-item">
                <a class="nav-link" href="database?action=topics">
                  <span data-feather="box"></span>
                  数据库
                </a>
              </li>[% END %]
            </ul>

            <h6 class="sidebar-heading d-flex justify-content-between align-items-center px-3 mt-4 mb-1 text-muted">
              <span>付费管理</span>
            </h6>
            <ul class="nav flex-column mb-2">
              <li class="nav-item">
                <a class="nav-link" href="ledger?action=topics">
                  <span data-feather="gift"></span>
                  记录
                </a>
              </li>
            </ul>

            <h6 class="sidebar-heading d-flex justify-content-between align-items-center px-3 mt-4 mb-1 text-muted">
              <span>购物</span>
            </h6>
            <ul class="nav flex-column mb-2">
              <li class="nav-item">
                <a class="nav-link" href="sale?action=topics">
                  <span data-feather="archive"></span>
                  历史
                </a>
              </li>
            </ul>

            <h6 class="sidebar-heading d-flex justify-content-between align-items-center px-3 mt-4 mb-1 text-muted">
              <span>联系我们</span>
            </h6>
            <ul class="nav flex-column mb-2">
              <li class="nav-item">
                <a class="nav-link" href="tt">
                  <span data-feather="help-circle"></span>
                  出错报告
                </a>
              </li>
            </ul>
          </div>
        </nav>

        <main role="main" class="col-md-9 ml-sm-auto col-lg-10 pt-3 px-4">
