[% INCLUDE start.en %]
  <style type="text/css" media="screen">
	.ace_editor {
		border: 1px solid lightgray; margin: auto; height: 200px; width: 100%;
	}
	.scrollmargin { height: 30px; text-align: center; }
  </style>
[% item=edit.0 %]

<section class="doc-section">

<h2>Component</h2>
<div class="section-block">

<div class="jumbotron text-left">
<form class="form" name=f1 method=post action="component">
<input type=hidden name="action" value="update">
<input type=hidden name="projectid" value="[% projectid %]">
<input type=hidden name="projectmd5" value="[% projectmd5 %]">
<input type=hidden name="componentid" value="[% item.componentid %]">

<div class="form-row">
  <div class="form-group col-md-6">
    <label for="nameComponent"><strong>Component Name</strong>:</label>
	<input type=text class="form-control" name="name_component" value="[% item.name_component %]">
  </div>
  <div class="form-group col-md-6">
    <label for="nameDesc"><strong>Description</strong>:</label>
	<input type=text class="form-control" name="description" value="[% item.description %]">
  </div>
</div>

<div class="form-row">
  <div class="form-group col-md-6">
    <label for="insertPars">Fields for <strong>Create</strong>:</label>
	<textarea class="form-control" name="insert_pars" aria-describedby="insertHelp" rows="2">[% item.insert_pars %]</textarea>
    <small id="insertHelp" class="form-text text-muted">List of table columns to use for CREATE action.</small>
  </div>

  <div class="form-group col-md-6">
    <label for="updatePars">Fields for <strong>Update</strong>:</label>
	<textarea class="form-control" name="update_pars" aria-describedby="updateHelp" rows="2">[% item.update_pars %]</textarea>
    <small id="updateHelp" class="form-text text-muted">List of table columns to use for UPDATE action.</small>
  </div>
</div>

<div class="form-row">
  <div class="form-group col-md-6">
    <label for="topicsPars">Fields for <strong>List</strong>:</label>
	<textarea class="form-control" name="topics_pars" aria-describedby="topicsHelp" rows="2">[% item.topics_pars %]</textarea>
    <small id="topicsHelp" class="form-text text-muted">List of table columns returned in LIST ALL action.</small>
  </div>

  <div class="form-group col-md-6">
    <label for="editPars">Fields for <strong>Read</strong>:</label>
	<textarea class="form-control" name="edit_pars" aria-describedby="editHelp" rows="2">[% item.edit_pars %]</textarea>
    <small id="editHelp" class="form-text text-muted">List of table columns returned in READ action.</small>
  </div>
</div>

<p> &nbsp; </p>
<h5>Join Multiple Tables for the <em>List</em> Action</h5>
<p></p>

<div class="form-row">
  <div class="form-group col-md-6">
    <label for="currentTables">Joined Tables:</label>
	<textarea class="form-control" name="current_tables" aria-describedby="tablesHelp" rows="4">[% item.current_tables %]</textarea>
    <small id="tablesHelp" class="form-text text-muted">Array of maps. In a map,
<strong>name</strong> is the table name; <strong>alias</strong> is table's alias;
<strong>on</strong> is the JOIN condition like <em>a.a_id=b.a_id</em> . For example:
<pre>[
  {"name":"[% item.table_edit.0.table_name %]", "alias":"a"},
  {"name":STRING, "alias":"b", "type":"inner", "on":STRING},
  {"name":STRING, "alias":"c", "type":"left", "on":STRING},
  ...
]</pre>
	</small>
  </div>
  <div class="form-group col-md-6">
    <label for="tohashPars">Fields to Report:</label>
	<textarea class="form-control" name="topics_hash" aria-describedby="tohashHelp" rows="4">[% item.topics_hash %]</textarea>
    <small id="tophashHelp" class="form-text text-muted">To map fields to names. For example:
<pre>{
  "a.column1" : "name1",
  "a.column2" : "name2",
  ...
  "b.column1" : "name3",
  "b.column2" : "name4",
  ...
}
</pre></small>
  </div>
</div>


<!-- div class="form-row">
  <div class="form-check col-md-1">
  </div>
  <div class="form-check col-md-3">
    <input class="form-check-input" type=checkbox name="pub_default" id="inputPublic" value=1>
    <label class="form-check-label" for="inputPublic">Public Default:</label>
  </div>
  <div class="form-check col-md-3">
    <input class="form-check-input" type=checkbox name="admin_default" id="inputAdmin" value=1>
    <label class="form-check-label" for="inputAdmin">Admin Default:</label>
  </div>
</div -->

<p> &nbsp; </p>
<h5>Access Control List</h5>
<p></p>

<div class="table-responsive">
<table class="table table-sm">
<thead>
<th rowspan=2>Role</th>
<th rowspan=2>Start</th>
<th rowspan=2>Create</th>
<th rowspan=2>List</th>
<th rowspan=2>Read</th>
<th rowspan=2>Update</th>
<th rowspan=2>Delete</th>
<th colspan=2>IN</th>
<th colspan=2>OUT</th>
</tr>
<tr>
<th>Key</th>
<th>MD5</th>
<th>Key</th>
<th>MD5</th>
</tr>
</thead>
<tbody>
<tr>
<td>Public</td>
<td class="text-center"><input class="form-check-input" type=checkbox [% IF crud_insert %]checked[% END %] name="public" value="startnew"></td>
<td class="text-center"><input class="form-check-input" type=checkbox [% IF crud_insert %]checked[% END %] name="public" value="insert"></td>
<td class="text-center"><input class="form-check-input" type=checkbox [% IF crud_topics %]checked[% END %] name="public" value="topics"></td>
<td class="text-center"><input class="form-check-input" type=checkbox [% IF crud_edit %]checked[% END %] name="public" value="edit"></td>
<td class="text-center"><input class="form-check-input" type=checkbox [% IF crud_update %]checked[% END %] name="public" value="update"></td>
<td class="text-center"><input class="form-check-input" type=checkbox [% IF crud_delete %]checked[% END %] name="public" value="delete"></td>
<td></td>
<td></td>
<td></td>
<td></td>
</tr>[% FOREACH hash=item.role_acl %]<input type=hidden name="md5_[% hash.roleid %]" value="[% hash.rolemd5 %]">
<tr>
<td>[% hash.name_role %]</td>
<td class="text-center"><input class="form-check-input" type=checkbox [% IF hash.startnew %]checked[% END %] name="crud_[% hash.roleid %]" value="startnew"></td>
<td class="text-center"><input class="form-check-input" type=checkbox [% IF hash.insert %]checked[% END %] name="crud_[% hash.roleid %]" value="insert"></td>
<td class="text-center"><input class="form-check-input" type=checkbox [% IF hash.topics %]checked[% END %] name="crud_[% hash.roleid %]" value="topics"></td>
<td class="text-center"><input class="form-check-input" type=checkbox [% IF hash.edit %]checked[% END %] name="crud_[% hash.roleid %]" value="edit"></td>
<td class="text-center"><input class="form-check-input" type=checkbox [% IF hash.update %]checked[% END %] name="crud_[% hash.roleid %]" value="update"></td>
<td class="text-center"><input class="form-check-input" type=checkbox [% IF hash.delete %]checked[% END %] name="crud_[% hash.roleid %]" value="delete"></td>
<td><input type=text class="form-control form-control-sm" name="inkey_[% hash.roleid %]" value="[% hash.inkey %]"></td>
<td><input type=text class="form-control form-control-sm" name="inmd5_[% hash.roleid %]" value="[% hash.inmd5 %]"></td>
<td><input type=text class="form-control form-control-sm" name="outkey_[% hash.roleid %]" value="[% hash.outkey %]"></td>
<td><input type=text class="form-control form-control-sm" name="outmd5_[% hash.roleid %]" value="[% hash.outmd5 %]"></td>
</tr>
[% END %]</tbody>
</table>
</div>

<div class=row>
    <div class="col-2"></div>
    <div class="col-4">
		<p></p>
        <button type=submit class="btn btn-primary">Submit</button>
    </div>
</div>

</form>
</div>

</div>
</section>


[% INCLUDE end.en %]
