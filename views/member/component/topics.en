[% INCLUDE start.en %]

<section class="doc-section">

<h2>Components in the Project</h2>
<div class="section-block">
<p>
Click on the component name to see the details.
</p>
<div class="table-responsive">
<table class="table table-striped">
	<thead class="thead-light">
<tr>
<th>Name</th>
<th>ID</th>
<th>Description</th>
<th>Table</th>
<th></th>
</tr>
</thead>
<tbody>[% FOREACH item=topics %][% IF (item.filter && item.model && item.component_json) %][% SET makecomp=1 %][% ELSE %][% SET makecomp=0 %][% END %]
<tr>
<td><a href="component?action=edit&componentid=[% item.componentid %]&projectid=[% projectid %]&projectmd5=[% projectmd5 %]">[% item.name_component %]</a></td>
<td><em>[% item.current_key %]</em></td>
<td>[% item.description %]</td>
<td>[% item.table_name %]</td>
<!-- td>
<a class="btn btn-sm btn-info" href="component?action=makecomp&componentid=[% item.componentid %]&projectid=[% projectid %]&projectmd5=[% projectmd5 %]">Generate</a>
</td -->
<td>
<a class="btn btn-sm btn-warning" href="component?action=delete&componentid=[% item.componentid %]&projectid=[% projectid %]&projectmd5=[% projectmd5 %]">DEL</a></td>
</tr>
[% END %]</tbody>
</table>
</div>

</div>
</section>

<section class="doc-section">

<h2>Add New Component</h2>
<div class="section-block">
<div class="jumbotron text-left">

<form class="form" action=component method=post>
<input type=hidden name=action value='insert'>
<input type=hidden name=csrf value='[% csrf %]'>
<input type=hidden name=projectid value='[% projectid %]'>
<input type=hidden name=projectmd5 value='[% projectmd5 %]'>
<div class="form-group row">
	<label for="inputName" class="col-sm-2 col-form-label">Name</label>
	<div class="col-sm-4">
		<input type="text" class="form-control" name=name_component id="inputName" placeholder="letters only">
	</div>
	<label for="inputTable" class="col-sm-2 col-form-label">Table</label>
	<div class="col-sm-4">
		<select name="tableid" class="form-control" onchange="role_check(this.value)"><option value="">-- select table --</option>
[% FOREACH item=table_topics %]<option value="[% item.tableid %]">[% item.table_name %]</option>[% END %]</select>
	</div>
</div>
<div class="form-group row">
	<label for="inputDesc" class="col-sm-2 col-form-label">Description</label>
	<div class="col-sm-10">
		<input type="text" class="form-control" name=description id="inputDesc" placeholder="about the component">
	</div>
</div>
<!--
<div class="form-group row">
	<div class="form-check form-check-inline col-sm-2">
	</div>
	<div class="form-check form-check-inline col-sm-4">
		<input class="form-check-input" type=checkbox name="pub_default" id="inputPublic" value=1>
		<label class="form-check-label" for="inputPublic">Public Default
	</div>
	<div class="form-check form-check-inline col-sm-4">
		<input class="form-check-input" type=checkbox name="admin_default" id="inputAdmin" value=1>
		<label class="form-check-label" for="inputAdmin">Admin Default
	</div>
</div>
-->

<p> &nbsp; </p>
<h5>Access Control List</h5>
<p></p>
<div class="table-responsive">
<table class="table table-sm">
<thead>
<th rowspan=2>Role</th>
<th rowspan=2>Start</th>
<th rowspan=2>Create</th>
<th rowspan=2>List</th>
<th rowspan=2>Read</th>
<th rowspan=2>Update</th>
<th rowspan=2>Delete</th>
<th colspan=2>IN</th>
<th colspan=2>OUT</th>
</tr>
<tr>
<th>Key</th>
<th>MD5</th>
<th>Key</th>
<th>MD5</th>
</tr>
</thead>
<tbody>
<tr>
<td>Public</td>
<td class="text-center"><input class="form-check-input" type=checkbox name="public" value="startnew"></td>
<td class="text-center"><input class="form-check-input" type=checkbox name="public" value="insert"></td>
<td class="text-center"><input class="form-check-input" type=checkbox name="public" value="topics"></td>
<td class="text-center"><input class="form-check-input" type=checkbox name="public" value="edit"></td>
<td class="text-center"><input class="form-check-input" type=checkbox name="public" value="update"></td>
<td class="text-center"><input class="form-check-input" type=checkbox name="public" value="delete"></td>
<td></td>
<td></td>
<td></td>
<td></td>
</tr>[% FOREACH item=role_topics %]<input type=hidden name="md5_[% item.roleid %]" value="[% item.rolemd5 %]">
<tr>
<td>[% item.name_role %]</td>
<td class="text-center"><input class="form-check-input" type=checkbox name="crud_[% item.roleid %]" value="startnew"></td>
<td class="text-center"><input class="form-check-input" type=checkbox name="crud_[% item.roleid %]" value="insert"></td>
<td class="text-center"><input class="form-check-input" type=checkbox name="crud_[% item.roleid %]" value="topics"></td>
<td class="text-center"><input class="form-check-input" type=checkbox name="crud_[% item.roleid %]" value="edit"></td>
<td class="text-center"><input class="form-check-input" type=checkbox name="crud_[% item.roleid %]" value="update"></td>
<td class="text-center"><input class="form-check-input" type=checkbox name="crud_[% item.roleid %]" value="delete"></td>
<td><input type=text class="form-control form-control-sm" id="inkey_[% item.roleid %]" name="inkey_[% item.roleid %]"></td>
<td><input type=text class="form-control form-control-sm" id="inmd5_[% item.roleid %]" name="inmd5_[% item.roleid %]"></td>
<td><input type=text class="form-control form-control-sm" id="outkey_[% item.roleid %]" name="outkey_[% item.roleid %]"></td>
<td><input type=text class="form-control form-control-sm" id="outmd5_[% item.roleid %]" name="outmd5_[% item.roleid %]"></td>
</tr>
[% END %]</tbody>
</table>
</div>

<div class=row>
	<div class="col-2"></div>
	<div class="col-4">
		<button type=submit class="btn btn-primary">Submit</button>
	</div>
</div>

</form>
</div>
</div>
</section>

<script>
function role_check(selectedValue) {
	if (selectedValue===null) return;
	var xh = new XMLHttpRequest()
	xh.onreadystatechange = function() {
		if (this.readyState == 4 && this.status == 200) {
			var data = JSON.parse(this.responseText);
			data.data.forEach(function (item) {
				if (item["three"] !== null && item.three !== undefined) {
					var three = document.getElementById("outkey_" + item["roleid"])
					if (three !== null) {
						three.value = item["three"]
						document.getElementById("outmd5_" + item["roleid"]).value = item["three"] + "_md5"
					}
				}
				if (item["one"] !== null) {
					var one = document.getElementById("inkey_" + item["roleid"])
					if (one !== null && item.one !== undefined) {
						one.value = item["one"];
						if (item["current_key"] !== null && item["current_key"] !== item["one"])
						document.getElementById("inmd5_" + item["roleid"]).value = item["one"] + "_md5";
					}
				}
			});
		}
	}[% FOREACH item=role_topics %]
    document.getElementById("inkey_[% item.roleid %]").value = '';
    document.getElementById("inmd5_[% item.roleid %]").value = '';
    document.getElementById("outkey_[% item.roleid %]").value = '';
    document.getElementById("outmd5_[% item.roleid %]").value = '';[% END %]
 
	xh.open("POST", "../json/role", true);
	xh.setRequestHeader("Content-type", "application/x-www-form-urlencoded");
	xh.send("action=topics_check&tableid="+selectedValue+"&projectid=[% projectid %]&projectmd5=[% projectmd5 %]");
	return;
}
</script>

[% INCLUDE end.en %]
