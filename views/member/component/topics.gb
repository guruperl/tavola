[% INCLUDE start.gb %]

<h2>分量开发</h2>

<div class="table-responsive">
<table class="table table-striped">
	<thead class="thead-dark">
<tr>
<th>名称</th>
<th>表格</th>
<th>主键</th>
<th></th>
<th></th>
</tr>
</thead>
<tbody>[% FOREACH item=topics %][% IF (item.filter && item.model && item.component_json) %][% SET makecomp=1 %][% ELSE %][% SET makecomp=0 %][% END %]
<tr>
<td>[% item.name_component %]</td>
<td>[% item.table_name %]</td>
<td>[% item.current_key %]</td>
<td>
<a class="btn btn-sm btn-primary" href="component?action=edit&componentid=[% item.componentid %]&projectid=[% projectid %]&projectmd5=[% projectmd5 %]">编辑</a>
</td>
<td>
<a class="btn btn-sm btn-warning" href="component?action=delete&componentid=[% item.componentid %]&projectid=[% projectid %]&projectmd5=[% projectmd5 %]">删除</a></td>
</tr>
[% END %]</tbody>
</table>
</div>

<h2>添加新分量</h2>

<form class="form" action=component method=post>
<input type=hidden name=action value='insert'>
<input type=hidden name=projectid value='[% projectid %]'>
<input type=hidden name=projectmd5 value='[% projectmd5 %]'>
<div class=row>
	<div class="col-2">名称:</div>
	<div class="col-3"><input class="form-control" type=text name='name_component' placeholder="只用小写字母"></div>
	<div class="col-2">选择表格:</div>
	<div class="col-3"><select name="table_name" class="form-control">[% FOREACH item=database_topics %]<option value="[% item.TABLE_NAME %]">[% item.TABLE_NAME %]</option>[% END %]</select></div>
</div>
<div class=row>
	<div class="col-4">是否作为外网访客的缺省分量:</div>
	<div class="col-1"><input class="form-control" type=checkbox name="pub_default" value=1></div>
	<div class="col-1"></div>
	<div class="col-4">是否作为管理员的缺省分量:</div>
	<div class="col-1"><input class="form-control" type=checkbox name="admin_default" value=1></div>
</div>

<p> </p>

<h5>设置Restful指令执行权限 (ACL)</h5>

<div class="table-responsive">
<table class="table table-sm">
<thead>
<tr>
<th>角色</th>
<th>开始页</th>
<th>Create</th>
<th>Read</th>
<th>Update</th>
<th>Delete</th>
<th>List</th>
<th>IN键</th>
<th>IN签名</th>
<th>OUT键</th>
<th>OUT签名</th>
</thead>
<tbody>
<tr>
<td>外网</td>
<td><input class="form-control" type=checkbox name="public" value="startnew"></td>
<td><input class="form-control" type=checkbox name="public" value="insert"></td>
<td><input class="form-control" type=checkbox name="public" value="edit"></td>
<td><input class="form-control" type=checkbox name="public" value="update"></td>
<td><input class="form-control" type=checkbox name="public" value="delete"></td>
<td><input class="form-control" type=checkbox name="public" value="topics"></td>
<td></td>
<td></td>
<td></td>
<td></td>
</tr>[% FOREACH item=role_topics %]<input type=hidden name="md5_[% item.roleid %]" value="[% item.rolemd5 %]">
<tr>
<td>[% item.name_role %]</td>
<td><input class="form-control" type=checkbox name="crud_[% item.roleid %]" value="startnew"></td>
<td><input class="form-control" type=checkbox name="crud_[% item.roleid %]" value="insert"></td>
<td><input class="form-control" type=checkbox name="crud_[% item.roleid %]" value="edit"></td>
<td><input class="form-control" type=checkbox name="crud_[% item.roleid %]" value="update"></td>
<td><input class="form-control" type=checkbox name="crud_[% item.roleid %]" value="delete"></td>
<td><input class="form-control" type=checkbox name="crud_[% item.roleid %]" value="topics"></td>
<td><input type=text class="form-control input-sm" name="inkey_[% item.roleid %]"></td>
<td><input type=text class="form-control input-sm" name="inmd5_[% item.roleid %]"></td>
<td><input type=text class="form-control input-sm" name="outkey_[% item.roleid %]"></td>
<td><input type=text class="form-control input-sm" name="outmd5_[% item.roleid %]"></td>
</tr>
[% END %]</tbody>
</table>
</div>

<div class=row>
	<div class="col-2"></div>
	<div class="col-4">
		<button type=submit class="btn btn-primary"> 提交 </button>
	</div>
</div>

</form>

[% INCLUDE end.gb %]
