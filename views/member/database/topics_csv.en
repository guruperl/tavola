<div class="jumbotron text-left">
<form name=f3 class="form" action="database" method=post enctype="multipart/form-data">
<input type=hidden name=action value='csv'>
<input type=hidden name=dbtype value='[% dbtype %]'>
<input type=hidden name=csrf   value='[% csrf %]'>
<input type=hidden name=projectid value=[% projectid %]>
<input type=hidden name=projectmd5 value=[% projectmd5 %]>

    <div class=row>
    <div class="col-2"></div>
    <div class="col-8">

<input type=file class="form-control btn btn-sm btn-default" name="dbfilename">
<p> </p>
<h5>Please specify the data type for each column:</h5>

<div class="table-responsive">
<table class="table table-striped table-condensed table-sm">
<thead>
<tr>
<th>Column #</th>
<th>Data Type</th>
</thead>
<tbody id="mybody"></tbody>
</table>
</div>  
<button class="btn btn-sm btn-info" type=button id="addrow">Add Row</button>
<p> </p>
<button class="btn btn-primary" onClick="return confirm('Make sure you have all column data types?')" type=submit>Submit</button>
	</div>
	</div>
</form>
</div>

