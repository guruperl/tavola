[% INCLUDE start.en %]

<section class="doc-section">
	<h2>Table <em>[% table_name %]</em> in Database</h2>
	<div class="section-block">

<div class="table-responsive">
<table class="table table-striped">
	<thead class="thead-light">
<tr>
<th>Name</th>
<th>Type</th>
<th>Null</th>
<th>Default</th>
</tr>
</thead>
<tbody>[% FOREACH item=edit %]
<tr>
<td>[% item.COLUMN_NAME %][% IF item.KEY %] <span class="badge badge-pill badge-primary">[% item.KEY %]</span>[% END %][% IF item.IS_AUTO_KEY %] <span class="badge badge-pill badge-success">Auto</span>[% END %]</td>
<td><pre>[% item.TYPE %]</pre></td>
<td>[% IF item.IS_NULLABLE %]<span class="badge badge-pill badge-success">yes</span>[% ELSE %]<span class="badge badge-pill badge-warning">no</span>[% END %]</td>
<td><em>[% item.DEFAULTS %]</em></td>
</tr>
[% END %]</tbody>
</table>
</div>

<h5>Foreign Keys:</h5>
<p><pre>
Primary  Table: <em>[% fks.0.PKTABLE_NAME %]</em>
Primary Column: <em>[% fks.0.PKCOLUMN_NAME %]</em>
Foreign Column: <em>[% fks.0.FKCOLUMN_NAME %]</em>
</pre>
</p>


	</div>
</section>

<section class="doc-section">
	<h2>Saved as</h2>
	<div class="section-block">

<div class="table-responsive">
<table class="table table-striped">
	<thead class="thead-light">
<tr>
<th>Name<th>
<th>Key<th>
<th>Auto ID<th>
<th>By Tabilet<th>
</tr>
	</thead>
<tbody>[% SET one = table_edit.0 %]
<tr>
<th>[% one.table_name %]<th>
<th>[% one.current_key %]<th>
<th>[% one.current_id_auto %]<th>
<th>[% IF one.is_tabilet %]<span class="badge badge-pill badge-success">yes</span>[% ELSE %]<span class="badge badge-pill badge-warning">no</span>[% END %]<th>
</tr>
</tbody>
</table>
</div>

<pre>
   Add: <em>[% one.insert_pars %]</em>
  Read: <em>[% one.edit_pars %]</em>
  List: <em>[% one.topics_pars %]</em>
Update: <em>[% one.update_pars %]</em>
</pre>


<h5>Foreign Keys in Table:</h5>
<p><pre>
Primary  Table: <em>[% one.fktable_topics.0.PKTABLE_NAME %]</em>
Primary Column: <em>[% one.fktable_topics.0.PKCOLUMN_NAME %]</em>
Foreign Column: <em>[% one.fktable_topics.0.FKCOLUMN_NAME %]</em>
</pre>
</p>

	</div>
</section>

[% INCLUDE end.en %]
