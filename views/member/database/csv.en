[% INCLUDE start.en %]

<section class="doc-section">
	<h2 class="section-title">Database Table</h2>
	<div class="section-block">
The following tables have been created:
[% IF table_names %][% SET i=0 %]
	[% FOREACH name IN table_names %][% IF i %], [% END %][% i=i+1 %]<em>[% name %]</em>[% END %]
[% ELSE %]none.[% END %]
	</div>
</section>

[% INCLUDE end.en %]
