[% INCLUDE start.gb %]

<h2>角色</h2>

<div class="table-responsive">
<table class="table table-striped">
	<thead class="thead-dark">
<tr>
<th>名称</th>
<th>认证方式</th>
<th>表格</th>
<th>ID</th>
<th>用户栏</th>
<th>密码栏</th>
<th>缺省分量</th>
<th>缺省指令</th>
<th></th>
</tr>
</thead>
<tbody>[% FOREACH item=topics %]
<tr>
<td><a href="role?action=edit&roleid=[% item.roleid %]&name_role=[% item.name_role %]&projectid=[% projectid %]&projectmd5=[% projectmd5 %]">[% item.name_role %]</a></td>
<td>[% item.authen %]</td>
<td>[% item.table_name %]</td>
<td>[% item.field_id %]</td>
<td>[% item.field_login %]</td>
<td>[% item.field_passwd %]</td>
<td>[% item.default_component %]</td>
<td>[% item.default_action %]</td>
<td><a class="btn btn-sm btn-warning" href="role?action=delete&roleid=[% item.roleid %]&projectid=[% projectid %]&projectmd5=[% projectmd5 %]">删除</a></td>
</tr>
[% END %]</tbody>
</table>
</div>

<h2>添加新登录角色</h2>

<form class="form" action=role method=post>
<input type=hidden name=action value='insert'>
<input type=hidden name=projectid value='[% projectid %]'>
<input type=hidden name=projectmd5 value='[% projectmd5 %]'>
<div class=row>
	<div class="col-3">角色名:</div>
	<div class="col-3"><input class="form-control" type=text name='name_role' placeholder="小写字母"></div>
	<div class="col-3">认证方式:</div>
	<div class="col-3"><select class="form-control" name=authen>
<option value=''>- 分类 -</option>
<option value='db'>数据库</option>
<option value='wechat'>微信</option>
<option value='qq'>QQ</option>
<option value='sina'>新浪微博</option>
</select></div>
</div>

<div class=row>
	<div class="col-3">缺省分量:</div>
	<div class="col-3"><input class="form-control" type=text name='default_component' placeholder="component"></div>
	<div class="col-3">缺省指令:</div>
	<div class="col-3"><input class="form-control" type=text name='default_action' placeholder="action"></div>
</div>

<div class=row>
	<div class="col-3">认证表格:</div>
	<div class="col-9"><input class="form-control-inline" type=checkbox checked name='is_auto' value='1' data-toggle='collapse' data-target='#user_table'>自动生成
</div>

<div class="collapse" id=user_table>

<div class=row>
	<div class="col-3">表格名称:</div>
	<div class="col-3"><input class="form-control" type=text name='table_name' placeholder="user"></div>
	<div class="col-3">主键名称:</div>
	<div class="col-3"><input class="form-control" type=text name='field_id' placeholder="user_id"></div>
</div>

<div class=row>
	<div class="col-3">用户栏:</div>
	<div class="col-3"><input class="form-control" type=text name='field_login' placeholder="email"></div>
	<div class="col-3">密码栏:</div>
	<div class="col-3"><input class="form-control" type=text name='field_passwd' placeholder="passwd"></div>
</div>

</div>

<div class=row>
	<div class="col-3"></div>
	<div class="col-3">
		<button type=submit class="btn btn-primary"> 提交 </button>
	</div>
</div>

</form>

[% INCLUDE end.gb %]
