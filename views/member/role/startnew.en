[% INCLUDE start.en %]

<section class="doc-section">
	<h2>Landing Pages</h2>
	<div class="section-block">

<p>
Default components and actions for roles:
</p>


<div class="table-responsive">
<table class="table table-striped">
	<thead class="thead-light">
<tr>
<th>Name</th>
<th>Component</th>
<th>Action</th>
<th> </th>
</tr>
</thead>

<tbody>
<tr><form name="f_p" class="form-inline" method=post action="project">
<input type=hidden name="action" value="update">
<input type=hidden name="projectid" value="[% projectid %]">
<input type=hidden name="projectmd5" value="[% projectmd5 %]">
<td>p</td>
<td><select name=def_component size=1><option value="">-- SELECT --</option>[% FOREACH c=component_topics %]
<option value="[% c.name_component %]"[% IF c.name_component==def_component %] selected[% END %]>[% c.name_component %]</option>
[% END %]</select>
</td>
<td><select name=def_action size=1><option value="">-- SELECT --</option>
<option value="topics"[% IF def_action=="topics" %] selected[% END %]>topics</option>
<option value="startnew"[% IF def_action=="startnew" %] selected[% END %]>startnew</option>
</select>
</td>
<td><button class="btn btn-sm btn-primary" type=submit>Upd</button></td></form>
</tr>

[% FOREACH item=startnew %]
<tr><form name="f_p[% item.roleid %]" class="form-inline" method=post action="role">
<input type=hidden name="action" value="update">
<input type=hidden name="projectid" value="[% projectid %]">
<input type=hidden name="projectmd5" value="[% projectmd5 %]">
<input type=hidden name="roleid" value="[% item.roleid %]">
<td><a href="role?action=edit&roleid=[% item.roleid %]&table_name=[% item.table_name %]&name_role=[% item.name_role %]&projectid=[% projectid %]&projectmd5=[% projectmd5 %]">[% item.name_role %]</a></td>
<td><select name=default_component size=1><option value="">-- SELECT --</option>[% FOREACH c=component_topics %]
<option value="[% c.name_component %]"[% IF c.name_component==item.default_component %] selected[% END %]>[% c.name_component %]</option>
[% END %]</select></td>
<td><select name=default_action size=1><option value="">-- SELECT --</option>
<option value="topics"[% IF item.default_action=="topics" %] selected[% END %]>topics</option>
<option value="edit"[% IF item.default_action=="edit" %] selected[% END %]>edit</option>
<option value="startnew"[% IF item.default_action=="startnew" %] selected[% END %]>startnew</option>
</select>
</td>
<td><button class="btn btn-sm btn-primary" type=submit>Upd</button></td></form>
</tr>
[% END %]
</tbody>
</table>
</div>

	</div>
</section>

[% INCLUDE end.en %]
