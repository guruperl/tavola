    <!-- Main Javascript -->          
    <script type="text/javascript" src="/assets/plugins/jquery-3.3.1.min.js"></script>
    <script type="text/javascript" src="/assets/plugins/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script type="text/javascript" src="/assets/plugins/prism/prism.js"></script>    
    <script type="text/javascript" src="/assets/plugins/jquery-scrollTo/jquery.scrollTo.min.js"></script>  
    <script type="text/javascript" src="/assets/plugins/lightbox/dist/ekko-lightbox.min.js"></script>      
    <script type="text/javascript" src="/assets/plugins/stickyfill/dist/stickyfill.min.js"></script>                                                              
    <script type="text/javascript" src="/assets/js/main.js"></script>
    
<script>
$(function () {
  $('[data-toggle="popover"]').popover();

[% IF (GENELET.obj=='nextpage') AND (GENELET.action=='topics') %]
  $('#componentid').on('change', function(e){
	if (this.value != "") {
    	$.ajax({
			url:"../json/component",
			tyep:'POST',
			data:{action:"edit", componentid:this.value, projectid:"[% projectid %]", projectmd5:"[% projectmd5 %]"},
		 	success:function(response) {
				pars = JSON.parse(response.data[0].table_edit[0].topics_pars);
				var h = "";
				pars.forEach(function(item, index) {
					h += "<option>"+item+"</option>";
				});
				$("#object_key").removeAttr('disabled').html(h);
			}
		});
	} else {
		$("#object_key").attr('disabled','disabled').html("<option value=''>-- Field --</option>");
	}
  });
  $('#otherid').on('change', function(e){
	if (this.value != "") {
    	$.ajax({
			url:"../json/component",
			tyep:'POST',
			data:{action:"edit", componentid:this.value, projectid:"[% projectid %]", projectmd5:"[% projectmd5 %]"},
		 	success:function(response) {
				pars = JSON.parse(response.data[0].table_edit[0].topics_pars);
				var h = "";
				pars.forEach(function(item, index) {
					h += "<option>"+item+"</option>";
				});
				$("#otherfk").removeAttr('disabled').html(h);
			}
		});
	} else {
		$("#otherfk").attr('disabled','disabled').html("<option value=''>-- Field --</option>");
	}
  });
[% END %]

[% IF (GENELET.obj=='role') AND (GENELET.action=='topics') %]
  $('#selectAuthen').on('change', function(e){
// console.log(this.value, this.options[this.selectedIndex].value, $(this).find("option:selected").val(),);
	$('#user_table').hide();
	$('#is_auto').prop("checked", true);
	if (this.value=="facebook") {
		$('#is_auto').attr("disabled", true);
		$('#selectHelp').text("Using Facebook OAuth 2.0 for Authentication.");
	} else if (this.value=="google") {
		$('#is_auto').attr("disabled", true);
		$('#selectHelp').text("Using Google OAuth 2.0 for Authentication.");
	} else if (this.value=="db") {
		$('#is_auto').removeAttr("disabled");
		$('#selectHelp').text("Using Login and Password for Authentication.");
	}
  });
  $("#is_auto").change(function() {
	if(this.checked) {
		$('#user_table').hide();
	} else {
		$('#user_table').show();
	}
  });
  $('#user_table').hide();
[% END %]

})
</script>

</body>
</html> 

