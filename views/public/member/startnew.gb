[% INCLUDE start.gb %]
        <h2>申请新会员</h2>
        <p class="lead">请填写如下表格</p>

          <form class="needs-validation" action="member" method="post">
	    <input type="hidden" name="action" value="insert">
            <h4>登录信息</h4>
<p>
                用户名: <input type="text" name="login"> (用户名将是你的子域名，只允许4-10位的字母和数字组合！开头必须是字母。)
</p>
<p>
                密码: <input type="password" name="passwd">
                再输入一次: <input type="password" name="confirm">
</p>
			<h4>个人信息</h4>
<p>
                姓: <input type="text" name="lastname">
                名: <input type="text" name="firstname">
</p>
<p>
                电子邮箱: <input type="text" name="email">
                电话: <input type="text" name="phone">
</p>
			<h4>通讯地址</h4>
<p>
                路名: <input type="text" name="street">
                城市: <input type="text" name="city">
</p>
<p>
               省或州:
                <select name="state">
                  <option value="">选...</option>
                  <option value="SHANGHAI">上海</option>
                  <option value="BEIJING">北京</option>
                  <option value="CA">加利福尼亚</option>
                  <option value="NY">纽约</option>
                </select>
                国家:
                <select name="country">
                  <option value="">选...</option>
                  <option value="China">中国</option>
                  <option value="Canada">加拿大</option>
                  <option value="United States">美国</option>
                </select>
                邮政编码: <input type="text" name="zip">
</p>
<p>
            <input type=submit value=" 提交 ">
</p>
          </form>

[% INCLUDE end.gb %]
