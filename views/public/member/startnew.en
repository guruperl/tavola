[% INCLUDE start.en %]


                <div id="doc-header" class="doc-header text-center">
                    <h1 class="doc-title"><span aria-hidden="true" class="icon icon_datareport_alt"></span> Price Plans</h1>
                </div><!--//doc-header-->
                <div class="doc-body row">
                    <div class="doc-content col-md-9 col-12 order-1">
                        <div class="content-inner">
                            <section id="chartjs" class="doc-section">
<p class="intro">All sign ups get a 7-day free trial.</p>
                                <h2 class="section-title">Please fill in:</h2>
                                <div class="section-block">
<form class="form" action="/script/tabi/public/en/member" method="post">
<input type="hidden" name="action" value="insert">


				<div class="cards-wrapper row">
                	<div class="col-md-12 col-12">
<div class="form-group row">
	<label for="inputLogin" class="col-sm-2 col-form-label">Login Name</label>
	<div class="col-sm-4">
		<input type="text" class="form-control" name=login id="inputLogin" placeholder="for example: sandy">
	</div>
	<div class="col-sm-6">
		<em>a-z0-9 only, length 4-10, starting with letter!</em>
	</div>
</div>
<div class="form-group row">
	<label for="inputPassword3" class="col-sm-2 col-form-label">Password</label>
	<div class="col-sm-4">
		<input type="password" class="form-control" name=passwd id="inputPassword3" placeholder="Password">
	</div>
	<label for="inputPassword4" class="col-sm-2 col-form-label">Confirm</label>
	<div class="col-sm-4">
		<input type="password" class="form-control" name=confirm id="inputPassword4" placeholder="Password">
	</div>
</div>
<div class="form-group row">
	<label for="inputFirst" class="col-sm-2 col-form-label">Firstname</label>
	<div class="col-sm-4">
		<input type="text" class="form-control" name=firstname id="inputFirst" placeholder="Firstname">
	</div>
	<label for="inputLast" class="col-sm-2 col-form-label">Lastname</label>
	<div class="col-sm-4">
		<input type="text" class="form-control" name=lastname id="inputLast" placeholder="Lastname">
	</div>
</div>
<div class="form-group row">
	<label for="inputEmail3" class="col-sm-2 col-form-label">Email</label>
	<div class="col-sm-4">
		<input type="email" class="form-control" name=email id="inputEmail3" placeholder="Email">
	</div>
	<label for="inputPhone" class="col-sm-2 col-form-label">Phone</label>
	<div class="col-sm-4">
		<input type="text" class="form-control" name=phone id="inputPhone" placeholder="Phone number">
	</div>
</div>
					</div>
				</div>

				<div id="cards-wrapper" class="cards-wrapper row">
                    <div class="item item-green col-lg-4 col-12">
                        <div class="item-inner">
                            <h3 class="title">Personal</h3>
                            <p class="intro"> $50 / mo </p>
                        <button type=submit class="btn btn-green btn-oval">Get it now</button>
                        </div><!--//item-inner-->
                    </div><!--//item-->
                    <div class="item item-pink col-lg-4 col-12">
                        <div class="item-inner">
                            <h3 class="title">Team</h3>
                            <p class="intro"> $1000 / yr </p>
                        <button type=submit class="btn btn-pink btn-oval">Get it now</button>
                        </div><!--//item-inner-->
                    </div><!--//item-->
                    <div class="item item-blue col-lg-4 col-12">
                        <div class="item-inner">
                            <h3 class="title">Enterprise</h3>
                            <p class="intro"> $9000 / yr </p>
                        <button type=submit class="btn btn-blue btn-oval">Get it now</button>
                        </div><!--//item-inner-->
                    </div><!--//item-->
				</div>


</form>

                                </div><!--//section-block-->
                            </section><!--//doc-section-->


                            <section id="personal" class="doc-section">
                                <h2 class="section-title"><span aria-hidden="true" class="icon icon_id-2 btn-green"></span>
								&nbsp; Personal Account</h2>
                                <div class="section-block">
                                    <h4 class="block-title">1. Ideal for Personal Usage</h4>
									<ul><li>$50 monthly
									    <li>1 Tabilet account
										<li>Up to 3 login roles per project
									</ul>
                                </div><!--//section-block-->
                                <div class="section-block">
                                    <h4 class="block-title">2. PHP Code</h4>
                                    <ul><li>Download PHP code
                                    <li>Install using <em>composer</em> on your webserver
									</ul>
								</div>
                                <div class="section-block">
                                    <h4 class="block-title">3. Serve APIs & Website</h4>
                                    <ul><li>Serve REST APIs from your data source
                                    <li>Automatically generate a website using the server-side Twig templating system
									</ul>
                                </div><!--//section-block-->
                            </section><!--//doc-section-->

                            <section id="group" class="doc-section">
                                <h2 class="section-title"><span aria-hidden="true" class="icon icon_group btn-pink"></span>
								&nbsp; Team Account</h2>
                                <div class="section-block">
                                    <h4 class="block-title">1. Ideal For Small Teams</h4>
									<ul><li>$1000 yearly
									    <li>3 Tabilet accounts
										<li>Unlimited login roles per project
									</ul>
                                </div><!--//section-block-->
                                <div class="section-block">
                                    <h4 class="block-title">2. PHP Code</h4>
                                    <ul><li>Download PHP code
                                    <li>Install using <em>composer</em> on your webserver
                                    <li>Programs to run unit tests and integration tests are included
									</ul>
								</div>
                                <div class="section-block">
                                    <h4 class="block-title">3. Serve APIs & Website</h4>
                                    <ul><li>Serve REST API from your data source
									<li>Build an one-page website based on Vue.js
                                    <li>Build a website using the server-side Twig templating system
									</ul>
                                </div><!--//section-block-->
                                <div class="section-block">
                                    <h4 class="block-title">4. Support</h4>
                                    <ul><li>Including 20 hours of email support 
									</ul>
                                </div><!--//section-block-->
                            </section><!--//doc-section-->

                            <section id="organization" class="doc-section">
                                <h2 class="section-title"><span aria-hidden="true" class="icon icon_flowchart btn-blue"></span>
								&nbsp; Enterprise Account</h2>
                                <div class="section-block">
                                    <h4 class="block-title">1. Ideal For Larger Teams or Enterprises</h4>
									<ul><li>$9000 yearly
									    <li>10 Tabilet accounts
										<li>Unlimited login roles per project
									</ul>
                                </div><!--//section-block-->
                                <div class="section-block">
                                    <h4 class="block-title">2. PHP, GO, Java and Perl</h4>
                                    <ul><li>Download source codes in PHP, GO, Java and Perl (Python is coming soon on the roadmap, and will be included in this account!)
                                    <li>Install on your preferred web server
                                    <li>Programs to run unit tests and integration tests are included
									</ul>
								</div>
                                <div class="section-block">
                                    <h4 class="block-title">3. Serve REST API, GraphQL and gRPC</h4>
                                    <ul><li>Serve your API in one of the popular formats, or all at the same time
									<li>Build an one-page website based on Vue.js
                                    <li>Build a website using the server-side templating system:
									<ul><li>Twig in PHP
										<li>Core text/template in GO
										<li>JSP in Java
										<li>Template::Toolkit in Perl
										</ul>
									</li>
									</ul>
                                </div><!--//section-block-->
                                <div class="section-block">
                                    <h4 class="block-title">4. Support</h4>
                                    <ul>
                                    <li>Includes 100 dedicated support hours (save time and resources!)
									<li>Additional add-on support plans are available
									</ul>
                                </div><!--//section-block-->
                            </section><!--//doc-section-->

                            
                        </div><!--//content-inner-->
                    </div><!--//doc-content-->
                    <div class="doc-sidebar col-md-3 col-12 order-0 d-none d-md-flex">
                        <div id="doc-nav" class="doc-nav">
                            <nav id="doc-menu" class="nav doc-menu flex-column sticky">
